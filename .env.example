# The password to sign in with, until you add people in Settings › People; then each signs in with a code by email
# or a password of their own. Leave it empty on your own computer, where nobody else can reach it.
BAMAH_PASSWORD=

# The port you open Bamah on. ChatGPT's sign-in comes back to http://127.0.0.1:<this port>.
BAMAH_PORT=8465

# Where the database, the portraits and the ChatGPT sign-in are kept.
DATA_DIR=./data

# What the app calls itself, and the time zone.
BAMAH_NAME=Bamah
TZ=UTC

# For invites and sign-in codes by email: the address people open it at, and who invites are signed by.
# The mail server itself goes in mail.json in the data folder (see app/bamah/mail.py).
BAMAH_URL=
BAMAH_SIGNATURE=
