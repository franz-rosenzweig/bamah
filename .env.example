# The password to sign in with. Leave it empty on your own computer, where nobody else can reach it.
BAMAH_PASSWORD=

# The port you open Bamah on. ChatGPT's sign-in comes back to http://127.0.0.1:<this port>.
BAMAH_PORT=8465

# Where the database, the portraits and the ChatGPT sign-in are kept.
DATA_DIR=./data

# What the app calls itself, and the time zone.
BAMAH_NAME=Bamah
TZ=UTC
