<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bamah for Windows (windows/README.md): WinUI 3 and WebView2 around the Bamah she uses.
       Unpackaged and self-contained: the folder dotnet publish makes runs as it is, and the
       installer only copies it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Bamah</RootNamespace>
    <AssemblyName>Bamah</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Bamah</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Bamah.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the address offered the first time: none, unless a build is given one (-p:BamahDefaultServer=…) -->
    <BamahDefaultServer Condition="'$(BamahDefaultServer)' == ''"></BamahDefaultServer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BamahDefaultServer" Value="$(BamahDefaultServer)" />
    <Content Include="Assets\Bamah.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\icon-64.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
